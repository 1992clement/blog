{% extends 'base.html.twig' %}

{% block title %}Article{% endblock %}

{% block body %}
    <h1>Article</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ article.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ article.title }}</td>
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ article.content }}</td>
            </tr>
            <tr>
                <th>CreationDate</th>
                <td>{{ article.creationDate ? article.creationDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ModificationDate</th>
                <td>{{ article.modificationDate ? article.modificationDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>{{ article.creator.username }}</td>
            </tr>
        </tbody>
    </table>

    {% if article.comments | length > 0 %}
        {{ article.comments | length }} comments :
        {% for comment in article.comments %}
        <p>
            {{ comment.text }} <br/>
            <b>{{ comment.author.username }} - {{ comment.creationDate|date }}</b>
        </p>
        {% endfor %}
    {% else %}
        There is no comment on this article.
    {% endif %}

    {{ form_start(form, {'action': path('app_article_comment', {'id' : article.id})}) }}
        {{ form_row(form.text) }}
    <button type="submit" class="btn btn-primary">Add comment</button>
    {{ form_end(form) }}

    <a href="{{ path('app_article_index') }}">back to list</a>

    <a href="{{ path('app_article_edit', {'id': article.id}) }}">edit</a>

    {{ include('article/_delete_form.html.twig') }}
{% endblock %}
